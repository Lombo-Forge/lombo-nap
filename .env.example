# Where Jellyfin answers, as seen from this app (a container name works when both share a network).
LOMBO_NAP_JELLYFIN_URL=http://jellyfin:8096
# Jellyfin: Dashboard > API Keys > +. One key per app, so you can revoke it alone.
LOMBO_NAP_JELLYFIN_API_KEY=changeme
# Optional. Any webhook that accepts JSON (Discord, Slack, or a bridge). Empty means no alerts.
LOMBO_NAP_WEBHOOK_URL=
# true = log what would be sent and stopped, change nothing. Set false only after reading the output of `plan`.
LOMBO_NAP_DRY_RUN=true
# Seconds between polls when running with --loop (1 second while someone is being asked). 5 to 3600.
LOMBO_NAP_POLL_SECONDS=30
# Hours of playback with no interaction before "Still watching?" appears. 1 to 6.
LOMBO_NAP_LIMIT_HOURS=3
# Seconds the person has to answer before playback is stopped. 10 to 3600.
LOMBO_NAP_GRACE_SECONDS=120
# Also ask after this many titles in a row with no interaction. 0 turns it off.
LOMBO_NAP_MAX_EPISODES=0
# Comma-separated Jellyfin user names that are never asked or stopped.
LOMBO_NAP_SKIP_USERS=
# Optional file where the counts are kept, so a restart does not give everyone a fresh count.
LOMBO_NAP_STATE_FILE=
# Wake report: where `lombo-nap wake sample` appends its one line per minute.
LOMBO_NAP_WAKE_LOG=/var/lib/lombo-nap/wake.jsonl
# Wake report: the root of the host's /proc and /sys. Leave as / unless the host is mounted elsewhere.
LOMBO_NAP_HOST_ROOT=/
# Wake report: lines kept in the log (one per minute is about 43000 a month). 1000 and up.
LOMBO_NAP_WAKE_KEEP_LINES=100000
